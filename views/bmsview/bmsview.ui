      <item>
       <widget class="QComboBox" name="cbProtocol">
        <property name="toolTip">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;请按硬件功能手动选择CMU协议版本；&lt;/p&gt;&lt;p&gt;1. CMU1.0-CMU3.0 适配软件版本0.0.1.x 至 0.0.3.x；CMU3.1新增绝缘数据点&lt;/p&gt;&lt;p&gt;2. CMU4.0 新增适配主动均衡；&lt;/p&gt;&lt;p&gt;3. CMU4.6 并充；&lt;/p&gt;&lt;p&gt;4. CMU4.8 主动均衡；&lt;/p&gt;&lt;p&gt;5. CMU4.9 在4.8基础上新增风扇转速获取与设置；&lt;/p&gt;&lt;p&gt;6. CMU4.10 适用主动均衡液冷CMU通信；&lt;/p&gt;&lt;p&gt;7. CMU5.0 基于CMU4.8的主动均衡新增三级告警；&lt;/p&gt;&lt;p&gt;如出现通信断连情况或无所需数据点，请尝试更换协议版本。&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <item>
         <property name="text">
          <string>CMU1.0</string>
         </property>
        </item>
        <item>
         <property name="text">
